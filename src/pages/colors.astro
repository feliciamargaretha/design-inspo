---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import FilterBar from "@/components/FilterBar";
import EntryCard from "@/components/EntryCard.astro";
import { getEntries } from "@/lib/content";
import { feelGroup, filterGroup } from "@/lib/filters";
import { COLOR_HARMONY_TERMS, COLOR_STRATEGY_TERMS } from "@/data/glossary";
import { COLOR_HARMONIES, COLOR_STRATEGIES } from "@/data/taxonomies";

const entries = await getEntries();
const groups = [
  filterGroup(
    "harmony",
    "Harmony",
    COLOR_HARMONIES,
    entries,
    (e) => [e.data.colors.harmony],
    (v) => COLOR_HARMONY_TERMS[v as keyof typeof COLOR_HARMONY_TERMS].name,
  ),
  filterGroup(
    "strategy",
    "Strategy",
    COLOR_STRATEGIES,
    entries,
    (e) => [e.data.colors.strategy],
    (v) => COLOR_STRATEGY_TERMS[v as keyof typeof COLOR_STRATEGY_TERMS].name,
  ),
  feelGroup(entries, (e) => e.data.tags),
];
---

<BaseLayout title="Colors">
  <PageHeader
    title="Colors"
    description="Every palette's primary colors, under the page they come from. Open one to see it on the color wheel, with its harmony and strategy explained."
  />
  <FilterBar client:load groups={groups} target="grid" />
  <div id="grid">
    <ul class="grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {entries.map((entry) => (
        <EntryCard
          entry={entry}
          anchor="#colors"
          palette={entry.data.colors.palette.filter(
            (c) => c.tier === "primary",
          )}
          filters={{
            harmony: [entry.data.colors.harmony],
            strategy: [entry.data.colors.strategy],
            feel: entry.data.tags,
          }}
        />
      ))}
    </ul>
    <p data-empty hidden class="py-16 text-center text-muted-foreground">
      Nothing matches these filters.
    </p>
  </div>
</BaseLayout>
