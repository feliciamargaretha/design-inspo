---
import BaseLayout from "@/layouts/BaseLayout.astro";
import EntryCard from "@/components/EntryCard.astro";
import { getEntries } from "@/lib/content";
import { GLOSSARY } from "@/data/glossary";
import { url } from "@/lib/url";

const entries = await getEntries();
const topics = [
  {
    href: "/colors/",
    title: "Colors",
    blurb: "Palettes on the color wheel: harmony, strategy and why.",
  },
  {
    href: "/typography/",
    title: "Typography",
    blurb: "Type specimens, classifications and type scales.",
  },
  {
    href: "/imagery/",
    title: "Imagery",
    blurb: "Visual styles, image treatments and textures, named.",
  },
  {
    href: "/motion/",
    title: "Motion",
    blurb: "Animations recorded from live pages, by technique.",
  },
];
---

<BaseLayout>
  <section class="max-w-3xl py-6 sm:py-12">
    <h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-6xl">
      Design inspiration, taken apart.
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-pretty text-muted-foreground">
      Landing pages and apps broken down into color, typography, imagery and
      motion: what each one uses, why (from the brand itself where possible),
      and the proper name for every style.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href={url("/inspiration/landing/")}
        class="inline-flex h-10 items-center rounded-md bg-foreground px-4 text-sm font-medium text-background transition-opacity hover:opacity-90"
      >
        Browse inspiration
      </a>
      <a
        href={url("/glossary/")}
        class="inline-flex h-10 items-center rounded-md border border-border px-4 text-sm font-medium transition-colors hover:bg-secondary"
      >
        Learn the vocabulary · {Object.keys(GLOSSARY).length} terms
      </a>
    </div>
  </section>

  <section class="mt-10">
    <div class="mb-6 flex items-baseline justify-between">
      <h2 class="text-xl font-semibold tracking-tight">Latest</h2>
      <a
        href={url("/inspiration/landing/")}
        class="text-sm text-muted-foreground hover:text-foreground"
      >
        See all →
      </a>
    </div>
    <ul class="grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {entries.slice(0, 6).map((entry) => (
        <EntryCard entry={entry} />
      ))}
    </ul>
  </section>

  <section class="mt-20">
    <h2 class="mb-6 text-xl font-semibold tracking-tight">Browse by topic</h2>
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {topics.map((t) => (
        <li>
          <a
            href={url(t.href)}
            class="block h-full rounded-xl border border-border p-5 transition-colors hover:bg-secondary"
          >
            <h3 class="font-semibold">{t.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
              {t.blurb}
            </p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
