---
// Every design term with its definition, plus real examples from entries.
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import ColorWheel from "@/components/ColorWheel.astro";
import { allExamples, getEntries, getFonts, mediaUrl } from "@/lib/content";
import { HARMONY_OFFSETS, type Harmony } from "@/lib/color";
import { TERM_GROUPS } from "@/lib/terms";
import { entryUrl, url } from "@/lib/url";
import { label } from "@/data/taxonomies";

const entries = await getEntries();
const libraryFonts = await getFonts();
const examples = allExamples(entries);

// Where each term is used, for the "Seen in" links.
const usedBy = (id: string) =>
  entries.filter((e) => {
    const { colors, typography, imagery, motion } = e.data;
    return [
      colors.harmony,
      colors.strategy,
      ...typography.fonts.map((f) => f.style),
      ...imagery.styles,
      ...imagery.treatments,
      ...imagery.textures,
      ...(motion?.types ?? []),
    ].includes(id as never);
  });

// Illustrative wheel for each harmony, from a neutral blue base hue.
const demo = (h: Harmony) =>
  HARMONY_OFFSETS[h].map((o, i) => ({
    hex: h === "monochromatic" ? toHex(215, [30, 50, 72][i]!) : toHex(215 + o),
  }));
function toHex(h: number, l = 52) {
  const s = 0.8;
  const a = s * Math.min(l / 100, 1 - l / 100);
  const f = (n: number) => {
    const k = (n + ((h + 360) % 360) / 30) % 12;
    const v = l / 100 - a * Math.max(-1, Math.min(k - 3, 9 - k, 1));
    return Math.round(v * 255)
      .toString(16)
      .padStart(2, "0");
  };
  return `#${f(0)}${f(8)}${f(4)}`.toUpperCase();
}
---

<BaseLayout title="Glossary">
  <PageHeader
    title="Glossary"
    description="The design vocabulary used on this site, in plain English, with real examples wherever we have one."
  />
  <nav aria-label="Glossary sections" class="mb-12 flex flex-wrap gap-1.5">
    {TERM_GROUPS.map((g) => (
      <a
        href={`#${g.id}`}
        class="rounded-full border border-border px-3 py-1 text-sm transition-colors hover:bg-secondary"
      >
        {g.title}
      </a>
    ))}
  </nav>

  <div class="space-y-16">
    {TERM_GROUPS.map((group) => (
      <section id={group.id} class="scroll-mt-24">
        <h2 class="mb-6 border-b border-border pb-3 text-2xl font-semibold tracking-tight">
          {group.title}
        </h2>
        <dl class="grid gap-x-10 gap-y-10 md:grid-cols-2">
          {Object.entries(group.terms).map(([id, t]) => {
            const example = examples.find((ex) => ex.terms.includes(id));
            const seen = usedBy(id);
            return (
              <div
                id={id}
                class="scroll-mt-24 target:rounded-xl target:bg-secondary target:p-4"
              >
                <dt class="text-lg font-semibold">{t.name}</dt>
                {t.aka?.length ? (
                  <dd class="text-sm text-muted-foreground">
                    Also: {t.aka.join(", ")}
                  </dd>
                ) : null}
                <dd class="mt-2 leading-relaxed text-pretty">{t.definition}</dd>
                {group.id === "color-harmony" && (
                  <dd class="mt-4">
                    <ColorWheel
                      harmony={id as Harmony}
                      harmonyColors={demo(id as Harmony)}
                      size={112}
                      compact
                      title={`${t.name} example`}
                    />
                  </dd>
                )}
                {example && (
                  <dd class="mt-4">
                    <a
                      href={entryUrl(example.entry.id) + `#${example.section}`}
                      class="block overflow-hidden rounded-xl border border-border bg-secondary"
                    >
                      <img
                        src={mediaUrl(example.entry.id, example.src)}
                        alt={example.alt}
                        loading="lazy"
                        class="w-full"
                      />
                    </a>
                  </dd>
                )}
                {libraryFonts.some((f) => f.data.style === id) && (
                  <dd class="mt-3 text-sm text-muted-foreground">
                    In the font library:{" "}
                    {libraryFonts
                      .filter((f) => f.data.style === id)
                      .map((f, i) => (
                        <>
                          {i > 0 && ", "}
                          <a
                            href={url(`/typography/library/${f.id}/`)}
                            class="text-foreground underline underline-offset-4"
                          >
                            {f.data.family}
                          </a>
                        </>
                      ))}
                  </dd>
                )}
                {seen.length > 0 && (
                  <dd class="mt-3 text-sm text-muted-foreground">
                    Seen in{" "}
                    {seen.map((e, i) => (
                      <>
                        {i > 0 && ", "}
                        <a
                          href={entryUrl(e.id)}
                          class="text-foreground underline underline-offset-4"
                        >
                          {e.productData.data.name} ({label(e.data.type)})
                        </a>
                      </>
                    ))}
                  </dd>
                )}
              </div>
            );
          })}
        </dl>
      </section>
    ))}
  </div>
</BaseLayout>
