---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import EntryCard from "@/components/EntryCard.astro";
import {
  getEntries,
  getFonts,
  type EntryWithProduct,
  type LibraryFont,
} from "@/lib/content";
import { tagUrl, url } from "@/lib/url";
import { PERSONALITY_TAGS, label } from "@/data/taxonomies";

export async function getStaticPaths() {
  const entries = await getEntries();
  const fonts = await getFonts();
  const used = PERSONALITY_TAGS.filter(
    (tag) =>
      entries.some((e) => e.data.tags.includes(tag)) ||
      fonts.some((f) => f.data.tags.includes(tag)),
  );
  return used.map((tag) => ({
    params: { tag },
    props: {
      tag,
      used,
      matching: entries.filter((e) => e.data.tags.includes(tag)),
      matchingFonts: fonts.filter((f) => f.data.tags.includes(tag)),
    },
  }));
}

interface Props {
  tag: string;
  used: string[];
  matching: EntryWithProduct[];
  matchingFonts: LibraryFont[];
}
const { tag, used, matching, matchingFonts } = Astro.props;
const total = matching.length + matchingFonts.length;
---

<BaseLayout title={label(tag)}>
  <PageHeader
    eyebrow="Personality"
    title={label(tag)}
    description={`${total} ${total === 1 ? "item" : "items"} with a ${tag} personality.`}
  />
  <ul class="mb-10 flex flex-wrap gap-1.5" aria-label="Other personalities">
    {used.map((t) => (
      <li>
        <a
          href={tagUrl(t)}
          aria-current={t === tag ? "page" : undefined}
          class="inline-block rounded-full border border-border px-3 py-1 text-sm transition-colors hover:bg-secondary aria-[current=page]:border-foreground aria-[current=page]:bg-foreground aria-[current=page]:text-background"
        >
          {label(t)}
        </a>
      </li>
    ))}
  </ul>
  <ul class="grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
    {matching.map((entry) => (
      <EntryCard entry={entry} />
    ))}
  </ul>
  {matchingFonts.length > 0 && (
    <section class="mt-14">
      <h2 class="mb-4 text-xl font-semibold tracking-tight">Fonts</h2>
      <ul class="flex flex-wrap gap-2">
        {matchingFonts.map((f) => (
          <li>
            <a
              href={url(`/typography/library/${f.id}/`)}
              class="inline-block rounded-lg border border-border px-4 py-2 transition-colors hover:bg-secondary"
            >
              {f.data.family}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
