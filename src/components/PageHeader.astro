---
interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
}
const { title, description, eyebrow } = Astro.props;
---

<header class="mb-8 max-w-2xl">
  {eyebrow && (
    <p class="mb-2 text-sm font-medium text-muted-foreground">{eyebrow}</p>
  )}
  <h1 class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
    {title}
  </h1>
  {description && (
    <p class="mt-3 text-base leading-relaxed text-pretty text-muted-foreground">
      {description}
    </p>
  )}
  <slot />
</header>
